{
  "name": "@fizzy/map-app",
  "private": true,
  "type": "module",
  "description": "Fizzy Maps: an MCP app (built with mcp-use) that renders sparkling-water orders on a Leaflet map.",
  "scripts": {
    "dev": "mcp-use dev --port 3001",
