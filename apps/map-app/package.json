    "start": "mcp-use start --port 3001",
    "typecheck": "mcp-use typecheck"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "mcp-use": "^2.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
